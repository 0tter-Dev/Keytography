      "UpdateVaultEntryRequest": {
        "required": [
          "title",
          "login",
          "password",
          "additionalFields"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "login": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": "string"
          },
          "additionalFields": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "VaultEntryDetailResponse": {
        "required": [
          "id",
          "title",
          "login",
          "password",
          "additionalFields",
          "createdAt",
          "updatedAt",
          "passwordScore",
          "passwordScoreDetail"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "login": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": "string"
          },
          "additionalFields": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "passwordScore": {
            "type": [
              "null",
