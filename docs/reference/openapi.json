  "components": {
    "schemas": {
      "CreateVaultEntryRequest": {
        "required": [
          "title",
          "login",
          "password",
          "additionalFields"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "login": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": "string"
          },
          "additionalFields": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "CriterionEvaluation": {
        "required": [
          "score",
          "passed"
        ],
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "format": "double"
          },
          "passed": {
            "type": "boolean"
          }
        }
      },
      "ForgotPasswordRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "GeneratePasswordRequest": {
        "required": [
          "length",
          "includeSymbols",
          "excludeAmbiguousCharacters",
          "minimumScore"
        ],
        "type": "object",
        "properties": {
          "length": {
            "type": "integer",
            "format": "int32"
          },
          "includeSymbols": {
            "type": "boolean"
          },
          "excludeAmbiguousCharacters": {
            "type": "boolean"
          },
          "minimumScore": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "GeneratePasswordResponse": {
        "required": [
          "password",
          "score",
          "scoreDetail"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "scoreDetail": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/CriterionEvaluation"
            }
          }
        }
      },
