root = true

# Regras universais, agnósticas de stack. Regras específicas por linguagem
# (indentação, tamanho de tab por extensão) entram quando a stack técnica
# for decidida (ver docs/PROJECT-ARCHITECTURE.md).
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
